# Copy to .env and fill in (never commit .env)

# The backend logs in as sunwai_app (no privileges of its own; it switches role per request)
DATABASE_URL=postgresql://sunwai_app:sunwai_app_dev@localhost:5432/sunwai

# LLM. Without a key the offline keyword classifier is used.
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
# auto = OpenAI if a key is set, otherwise offline.  Or force: openai / offline
LLM_MODE=auto

# Signs login tokens. Any long random string.
SECRET_KEY=change-me-to-a-long-random-string
# How often overdue complaints are escalated (seconds). 0 = off.
SCHEDULER_SECONDS=300
